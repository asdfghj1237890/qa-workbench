# Default deny: only build inputs may leave the checkout for Docker.
**

# Build controls and locked Python distribution metadata.
!Dockerfile
!.dockerignore
!pyproject.toml
!README.md
!BACKEND.md
!requirements.lock

!src
src/*

!src/qa_workbench
src/qa_workbench/*
!src/qa_workbench/*.py

!src/qa_workbench/testing
src/qa_workbench/testing/*
!src/qa_workbench/testing/*.py

# Vite build metadata and runtime UI source; tests and operator files stay out.
!frontend
frontend/*
!frontend/package.json
!frontend/yarn.lock
!frontend/.yarnrc.yml
!frontend/index.html
!frontend/vite.config.js

!frontend/src
frontend/src/*
!frontend/src/*.js
!frontend/src/*.vue

!frontend/src/adapters
frontend/src/adapters/*
!frontend/src/adapters/*.js

!frontend/src/components
frontend/src/components/*
!frontend/src/components/*.vue

!frontend/src/components/workbench
frontend/src/components/workbench/*
!frontend/src/components/workbench/*.vue

!frontend/src/composables
frontend/src/composables/*
!frontend/src/composables/*.js

!frontend/src/css
frontend/src/css/*
!frontend/src/css/*.css

!frontend/src/i18n
frontend/src/i18n/*
!frontend/src/i18n/*.json

!frontend/src/lib
frontend/src/lib/*
!frontend/src/lib/*.js

!frontend/src/pages
frontend/src/pages/*
!frontend/src/pages/*.vue

!frontend/public
frontend/public/*

!frontend/public/fonts
frontend/public/fonts/*

!frontend/public/fonts/qa
frontend/public/fonts/qa/*
!frontend/public/fonts/qa/qa-serif-ui.woff2
!frontend/public/fonts/qa/qa-sans-ui.woff2
!frontend/public/fonts/qa/qa-mono-400.woff2
!frontend/public/fonts/qa/qa-mono-500.woff2
!frontend/public/fonts/qa/qa-mono-600.woff2
!frontend/public/fonts/qa/OFL-Noto-Serif-TC.txt
!frontend/public/fonts/qa/OFL-Noto-Sans-TC.txt
!frontend/public/fonts/qa/OFL-IBM-Plex-Mono.txt
!frontend/public/fonts/qa/README.md

# Installable RAG core only: metadata plus implementation/protocol docs.
!packages
packages/*

!packages/rag-evalkit
packages/rag-evalkit/*
!packages/rag-evalkit/pyproject.toml
!packages/rag-evalkit/README.md
!packages/rag-evalkit/MANIFEST.in

!packages/rag-evalkit/src
packages/rag-evalkit/src/*

!packages/rag-evalkit/src/rag_evalkit
packages/rag-evalkit/src/rag_evalkit/*
!packages/rag-evalkit/src/rag_evalkit/*.py
!packages/rag-evalkit/src/rag_evalkit/README.md

!packages/rag-evalkit/src/rag_evalkit/embeddings
packages/rag-evalkit/src/rag_evalkit/embeddings/*
!packages/rag-evalkit/src/rag_evalkit/embeddings/*.py
!packages/rag-evalkit/src/rag_evalkit/embeddings/README.md

!packages/rag-evalkit/src/rag_evalkit/harnesses
packages/rag-evalkit/src/rag_evalkit/harnesses/*
!packages/rag-evalkit/src/rag_evalkit/harnesses/*.py
!packages/rag-evalkit/src/rag_evalkit/harnesses/README.md

!packages/rag-evalkit/src/rag_evalkit/integrations
packages/rag-evalkit/src/rag_evalkit/integrations/*
!packages/rag-evalkit/src/rag_evalkit/integrations/*.py
!packages/rag-evalkit/src/rag_evalkit/integrations/README.md

!packages/rag-evalkit/src/rag_evalkit/models
packages/rag-evalkit/src/rag_evalkit/models/*
!packages/rag-evalkit/src/rag_evalkit/models/*.py
!packages/rag-evalkit/src/rag_evalkit/models/README.md

!packages/rag-evalkit/src/rag_evalkit/stores
packages/rag-evalkit/src/rag_evalkit/stores/*
!packages/rag-evalkit/src/rag_evalkit/stores/*.py
!packages/rag-evalkit/src/rag_evalkit/stores/README.md

# Apply recursive private/runtime exclusions AFTER every allow rule.
**/.git
**/.git/**
**/.venv
**/.venv/**
**/venv
**/venv/**
**/node_modules
**/node_modules/**
**/__pycache__
**/__pycache__/**
